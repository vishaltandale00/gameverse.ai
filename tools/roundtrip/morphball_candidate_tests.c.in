CHECK(call(d,0x08063d48,gObjectEvents,0,&result));d->busWrite8(d,gPlayerAvatar,1);
CHECK(movement(d,0,&action,&flags));CHECK(action==19);CHECK(!(flags&128));
CHECK(call(d,0x08063d48,gObjectEvents,0,&result));d->busWrite8(d,gPlayerAvatar,1);d->busWrite8(d,gMapHeader+25,0);
CHECK(movement(d,2,&action,&flags));CHECK(action==19);CHECK(!(flags&128));
CHECK(call(d,0x08063d48,gObjectEvents,0,&result));d->busWrite8(d,gPlayerAvatar,1);d->busWrite8(d,gMapHeader+25,2);d->busWrite8(d,gObjectEvents+30,10);d->busWrite32(d,0x02012280,10);
CHECK(movement(d,2,&action,&flags));CHECK(action==19);CHECK(!(flags&128));
CHECK(call(d,0x08063d48,gObjectEvents,0,&result));d->busWrite8(d,gPlayerAvatar,2);d->busWrite8(d,gObjectEvents+30,0);d->busWrite32(d,0x02012280,0);
unsigned foot_before=foot_movement_hits,bike_before=bike_movement_hits;CHECK(call3(d,0x0805b4e8,4,0,2,&result));CHECK(foot_movement_hits==foot_before);CHECK(bike_movement_hits==bike_before+1);CHECK(!(d->busRead8(d,gPlayerAvatar)&128));
CHECK(ability(d,&candidate_owned));CHECK(candidate_owned==1);
