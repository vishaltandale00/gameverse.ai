CHECK(argc==3);unsigned retained_boot=boot_frames;boot_frames=0;struct mCore*d=load(argv[2]);boot_frames=retained_boot;CHECK(d);watched_callback=SWAP_CALLBACK;
CHECK(boot_state);CHECK(d->stateSize(d)==boot_state_bytes);CHECK(d->loadState(d,boot_state));free(boot_state);boot_state=NULL;
