CHECK(candidate_cycle(d,0x08166349,30,&ticks_bottom));
/* Real canonical ownership survives source-supported SaveBlock1 relocation.
   This is an in-memory alias test, not serialized-save compatibility. */
uint8_t saved[0x3d68];for(unsigned i=0;i<sizeof(saved);i++)saved[i]=d->busRead8(d,gSaveBlock1+i);
for(unsigned i=0;i<sizeof(saved);i++)d->busWrite8(d,gSaveBlock1+64+i,saved[i]);
d->busWrite32(d,gSaveBlock1Ptr,gSaveBlock1+64);CHECK(ability(d,&candidate_owned));CHECK(candidate_owned==1);
d->busWrite32(d,gSaveBlock1Ptr,gSaveBlock1);for(unsigned i=0;i<sizeof(saved);i++)d->busWrite8(d,gSaveBlock1+i,saved[i]);
/* All source admission predicates are recomputed on each callback poll. */
unsigned negative_cases=0;
for(unsigned kind=0;kind<4;kind++){
 unsigned scene=kind==0?0:1,x=kind==1?52:53,y=kind==2?31:28,map=kind==3?3:2;
 CHECK(prepare_host(d,scene,x,y,map));CHECK(script_start(d,0x0816632f));
 unsigned notify_before=notification_calls;
 for(unsigned i=0;i<16;i++){CHECK(script_tick(d,0,&result));CHECK(ability(d,&candidate_owned));CHECK(candidate_owned==0);}
 CHECK(notification_calls==notify_before);CHECK(d->busRead16(d,gSaveBlock1+0x10d8)==scene);CHECK(d->busRead8(d,gObjectEvents+36)&1);CHECK(d->busRead8(d,CTX+1)==2);negative_cases++;
}
/* Native InitScriptContext resets the lease and scratch; a previously blocked
