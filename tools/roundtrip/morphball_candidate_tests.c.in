CHECK(prepare_host(d,1,53,28,2));CHECK(call(d,0x08069450,0x0817e9e8,0,&result));CHECK(result==1);
CHECK(script_start(d,0x0816632f));unsigned trap_before=trap_hits;int rejected=0;
for(unsigned i=0;i<8;i++){if(!script_tick(d,0,&result)){rejected=1;break;}}
CHECK(rejected);CHECK(trap_hits==trap_before+1);CHECK(ability(d,&candidate_owned));CHECK(candidate_owned==0);CHECK(d->busRead16(d,gSaveBlock1+0x10d8)==1);
