unsigned duplicate_notify=notification_calls,duplicate_fanfare=fanfare_calls;
CHECK(script_start(d,0x0816632f));for(unsigned i=0;i<8;i++)CHECK(script_tick(d,0,&result));
CHECK(notification_calls==duplicate_notify);CHECK(fanfare_calls==duplicate_fanfare);CHECK(d->busRead16(d,gSaveBlock1+0x10d8)==2);
/* The host busy-window adaptation rejects before donor Get commits ownership;
