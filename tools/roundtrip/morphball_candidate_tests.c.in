/* Exact original coordinate caller remains native. Its early ownership is0;
   the candidate takes the donor's early permanent-ownership transition. */
CHECK(prepare_host(c,1,53,28,2));CHECK(prepare_host(d,1,53,28,2));
CHECK(script_start(c,0x0816632f));CHECK(script_start(d,0x0816632f));
unsigned original_owned=0,candidate_owned=0,first_grant_tick=0;
for(unsigned i=0;i<8;i++){
 CHECK(script_tick(c,0,&result));CHECK(script_tick(d,0,&result));
 CHECK(ability(c,&original_owned));CHECK(ability(d,&candidate_owned));CHECK(original_owned==0);
 if(candidate_owned){first_grant_tick=i+1;break;}
}
CHECK(first_grant_tick>0);CHECK(c->busRead16(c,gSaveBlock1+0x10d8)==1);
CHECK(d->busRead16(d,gSaveBlock1+0x10d8)==1);
unsigned ticks_top=0,ticks_mid=0,ticks_bottom=0;
CHECK(candidate_cycle(d,0x0816632f,28,&ticks_top));
