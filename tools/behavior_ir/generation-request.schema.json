{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executable IR generation request",
  "type": "object",
  "required": [
    "schema",
    "request_id",
    "selections"
  ],
  "properties": {
    "schema": {
      "const": "gameverse.ir.generation-request/0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "title": {
      "type": "string",
      "pattern": "^[A-Za-z0-9 _-]{1,12}$"
    },
    "selections": {
      "type": "object",
      "required": [
        "movement",
        "combat",
        "progression"
      ],
      "additionalProperties": false,
      "properties": {
        "movement": {
          "type": "string"
        },
        "combat": {
          "type": "string"
        },
        "progression": {
          "type": "string"
        }
      }
    },
    "qualification": {
      "type": "object",
      "properties": {
        "run": {
          "type": "boolean"
        }
      }
    },
    "expected_catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
