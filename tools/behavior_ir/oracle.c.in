static unsigned long instructions;
static int call(struct mCore*c,uint32_t pc,const uint32_t*args,uint32_t*result){struct ARMCore*cpu=c->cpu;for(unsigned i=0;i<16;i++)cpu->gprs[i]=0;for(unsigned i=0;i<4;i++)cpu->gprs[i]=args[i];for(unsigned i=4;i<12;i++)cpu->gprs[i]=0x9e3779b9u*i;cpu->gprs[ARM_SP]=0x03007e00;cpu->gprs[ARM_LR]=0x08000001;cpu->cpsr.i=1;cpu->cycles=0;cpu->nextEvent=INT_MAX;_ARMSetMode(cpu,MODE_THUMB);cpu->gprs[ARM_PC]=pc;ThumbWritePC(cpu);unsigned n=0;while((uint32_t)cpu->gprs[ARM_PC]-2!=0x08000000&&n<2048){ARMRun(cpu);n++;}instructions+=n;*result=cpu->gprs[0];for(unsigned i=4;i<12;i++)if((uint32_t)cpu->gprs[i]!=0x9e3779b9u*i)return 0;if(cpu->gprs[ARM_SP]!=0x03007e00)return 0;return n<2048;}
static void wr(struct mCore*c,uint32_t a,const void*p,unsigned n){for(unsigned i=0;i<n;i++)c->busWrite8(c,a+i,((uint8_t*)p)[i]);}
static void rd(struct mCore*c,uint32_t a,void*p,unsigned n){for(unsigned i=0;i<n;i++)((uint8_t*)p)[i]=c->busRead8(c,a+i);}
static const struct{uint32_t address;unsigned machine,generated,bytes,object;uint32_t minimum,maximum;}fields[]={@FIELDS@};
static const struct{uint32_t address;unsigned generated,bytes,object,offset;}collections[]={@COLLECTIONS@};
static const struct{unsigned reg,bytes;uint32_t minimum,maximum;}parameters[]={@PARAMETERS@};
static unsigned char parameter_observed[4][256];
static uint32_t rng=0x193a5a31;
static uint32_t random32(void){rng^=rng<<13;rng^=rng>>17;rng^=rng<<5;return rng;}
@FIXTURE_DATA@
static uint32_t value(unsigned test,unsigned field,unsigned bytes){if(test<FIXTURE_COUNT&&field<FIXTURE_FIELDS)return fixture_values[test][field];unsigned bits=bytes*8;uint32_t max=bits==32?UINT_MAX:((1u<<bits)-1);const uint32_t edges[]={0,1,max,max-1,1u<<(bits-1),(1u<<(bits-1))-1,0x80,0x40,0x800,0x1df,30};if(test<121)return edges[(test+field*7)%11]&max;return random32()&max;}
int main(int argc,char**argv){if(argc!=3)return 2;struct mCore*c=GBACoreCreate();if(!c||!c->init(c))return 3;mCoreInitConfig(c,NULL);mCoreConfigSetDefaultIntValue(&c->config,"skipBios",1);mCoreConfigSetDefaultIntValue(&c->config,"useBios",0);mCoreLoadConfig(c);if(!mCoreLoadFile(c,argv[1]))return 4;c->reset(c);FILE*f=fopen(argv[2],"rb");int v;unsigned off=0;while((v=fgetc(f))!=EOF)c->busWrite8(c,0x02020000+off++,v);fclose(f);
for(unsigned test=0;test<@VECTORS@;test++){uint8_t raw[@OBJECT_COUNT@][@ENTITY_BYTES@],actual[@OBJECT_COUNT@][@ENTITY_BYTES@],expected[@OBJECT_COUNT@][@ENTITY_BYTES@];memset(raw,0xa5,sizeof(raw));LiftedState state;memset(&state,0x5a,sizeof(state));for(unsigned j=0;j<sizeof(fields)/sizeof(fields[0]);j++){uint32_t v=value(test,j,fields[j].bytes);if(fields[j].minimum||fields[j].maximum!=UINT_MAX)v=fields[j].minimum+v%(fields[j].maximum-fields[j].minimum+1u);memcpy((uint8_t*)&state+fields[j].generated,&v,fields[j].bytes);if(!fields[j].address)memcpy(raw[fields[j].object]+fields[j].machine,&v,fields[j].bytes);else wr(c,fields[j].address,&v,fields[j].bytes);}uint32_t original_args[4]={0},generated_args[4]={0x02024000,0,0,0},original_result,generated_result;@ENTITY_ARGS@ @REFERENCE_SETUP@
for(unsigned j=0;j<sizeof(parameters)/sizeof(parameters[0]);j++){uint32_t v=@PARAMETER_VALUE@;if(parameters[j].minimum||parameters[j].maximum!=UINT_MAX)v=parameters[j].minimum+v%(parameters[j].maximum-parameters[j].minimum+1u);parameter_observed[j][v&255]=1;original_args[parameters[j].reg]=v;generated_args[j+1]=v;}
for(unsigned j=0;j<sizeof(collections)/sizeof(collections[0]);j++){for(unsigned b=0;b<collections[j].bytes;b++){uint8_t v=(uint8_t)random32();((uint8_t*)&state)[collections[j].generated+b]=v;}if(collections[j].address)wr(c,collections[j].address,(uint8_t*)&state+collections[j].generated,collections[j].bytes);else memcpy(raw[collections[j].object]+collections[j].offset,(uint8_t*)&state+collections[j].generated,collections[j].bytes);}
memcpy(expected,raw,sizeof(raw));for(unsigned oi=0;oi<@OBJECT_COUNT@;oi++)wr(c,0x02010000+oi*8192,raw[oi],@ENTITY_BYTES@);if(!call(c,@ORIGINAL_ENTRY@,original_args,&original_result)){fprintf(stderr,"original instruction cap at%u\n",test);return 5;}for(unsigned oi=0;oi<@OBJECT_COUNT@;oi++)rd(c,0x02010000+oi*8192,actual[oi],@ENTITY_BYTES@);uint8_t globals[sizeof(fields)/sizeof(fields[0])][8];for(unsigned j=0;j<sizeof(fields)/sizeof(fields[0]);j++)if(fields[j].address)rd(c,fields[j].address,globals[j],fields[j].bytes);uint8_t collection_actual[4096];unsigned collection_cursor=0;for(unsigned j=0;j<sizeof(collections)/sizeof(collections[0]);j++){rd(c,collections[j].address?collections[j].address:0x02010000+collections[j].object*8192+collections[j].offset,collection_actual+collection_cursor,collections[j].bytes);collection_cursor+=collections[j].bytes;}
wr(c,0x02024000,&state,sizeof(state));if(!call(c,@GENERATED_ENTRY@,generated_args,&generated_result)){fprintf(stderr,"generated instruction cap at%u\n",test);return 6;}rd(c,0x02024000,&state,sizeof(state));@RETURN_CHECK@
collection_cursor=0;for(unsigned j=0;j<sizeof(collections)/sizeof(collections[0]);j++){if(memcmp(collection_actual+collection_cursor,(uint8_t*)&state+collections[j].generated,collections[j].bytes)){fprintf(stderr,"collection mismatch test%u collection%u\n",test,j);return 10;}if(!collections[j].address)memcpy(expected[collections[j].object]+collections[j].offset,(uint8_t*)&state+collections[j].generated,collections[j].bytes);collection_cursor+=collections[j].bytes;}
for(unsigned j=0;j<sizeof(fields)/sizeof(fields[0]);j++){if(!fields[j].address)memcpy(expected[fields[j].object]+fields[j].machine,(uint8_t*)&state+fields[j].generated,fields[j].bytes);else if(memcmp(globals[j],(uint8_t*)&state+fields[j].generated,fields[j].bytes)){fprintf(stderr,"global mismatch %u field%u\n",test,j);return 8;}}if(memcmp(expected,actual,sizeof(raw))){for(unsigned oi=0;oi<@OBJECT_COUNT@;oi++)for(unsigned j=0;j<@ENTITY_BYTES@;j++)if(expected[oi][j]!=actual[oi][j])fprintf(stderr,"mismatch test%u object%u byte%u expected%u actual%u\n",test,oi,j,expected[oi][j],actual[oi][j]);return 7;}}
printf("{\"outcome\":\"pass\",\"vectors\":@VECTORS@,\"instructions_total\":%lu}\n",instructions);fprintf(stderr,"parameter_low8_distinct:");for(unsigned j=0;j<sizeof(parameters)/sizeof(parameters[0]);j++){unsigned n=0;for(unsigned k=0;k<256;k++)n+=parameter_observed[j][k];fprintf(stderr," %u",n);}fprintf(stderr,"\n");c->deinit(c);return 0;}
