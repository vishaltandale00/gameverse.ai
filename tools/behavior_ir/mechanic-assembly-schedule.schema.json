{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gameverse.mechanic-assembly-schedule/0.1",
  "title": "Optional bounded schedule extension to mechanic-assembly/0.1",
  "description": "Structural extension only. assembly.validate is authoritative for package identity, source effects, ownership, predicates, invocation ordering and freshness. Absence preserves legacy binding-only admission.",
  "type": "object",
  "properties": {
    "schedule": {
      "type": "object",
      "required": [
        "phases"
      ],
      "additionalProperties": false,
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          }
        }
      }
    },
    "invocations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "phase": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "when": {
            "$ref": "#/$defs/expression"
          },
          "requires": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "required": [
                "slot",
                "producer"
              ],
              "additionalProperties": false,
              "properties": {
                "slot": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                },
                "producer": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                },
                "after_writes": {
                  "type": "array",
                  "maxItems": 128,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "expression": {
      "type": "object",
      "required": [
        "op",
        "type"
      ],
      "properties": {
        "op": {
          "enum": [
            "slot",
            "const",
            "bit_and",
            "bit_or",
            "bit_xor",
            "equal",
            "not_equal",
            "less_unsigned",
            "less_equal_unsigned",
            "less_signed",
            "less_equal_signed",
            "bool_and",
            "bool_or",
            "bool_not"
          ]
        },
        "type": {
          "enum": [
            "u8",
            "u16",
            "u32",
            "u64"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/expression"
          }
        }
      },
      "additionalProperties": false,
      "description": "Runtime validator additionally enforces exact operator arity/types, constant width, known scalar slot and semantic compatibility, predicate u8 root, at most64 nodes and depth12. No raw C, calls, shifts or dynamic indexing."
    }
  }
}
