{
  "version": "sonic-metroid-campaign/1",
  "id": "sonic-metroid-signal-descent",
  "foundation": {
    "game": "sonic-advance",
    "rom_sha1": "d842afa7dd1e84de08addb94a51506f1bcafd551",
    "stage_table": "0x084a6da4",
    "preserve": "native whole campaign progression, geometry, bosses, parallax and loops"
  },
  "authorship": {
    "new": "route-relative prefabs, alien AI, progression placements, story, tiny OBJ art and integration glue",
    "recovered": "MZM damage/cooldown/caps/freeze/drops, motion; Sonic controller/contact/entity/task/render services"
  },
  "coordinate_contract": {
    "x": "absolute native world pixels",
    "floor_offset": "pixels relative to recovered nearby floor at activation; lookup nearest player-height route",
    "activation_radius_px": 180,
    "bounded_geometry_search_px": "symmetric112px about current route floor",
    "terrain_layer": "native player+0x27; never silently use the empty plane0",
    "scripted_contact_rule": "Freeze tutorial belongs to open-air coast; Factory low ceiling and external-motion rail admit beam seals only.",
    "freeze_gateway_clearance": "Coast1130..1190 has no upper platform; do not place the support under the native elevated platforms beginning near1224."
  },
  "progression": {
    "persistence": "native flag2 task data; reset on cartridge coldboot, fullRAM checkpoints retain it; no new SRAM save format",
    "graph": [
      "morph->bomb->bomb_gate",
      "missile->missile_gate",
      "high_jump->high_gate",
      "ice->frozen_creature->ice_platform_gate",
      "varia->heat_resistance",
      "speed->momentum_gate",
      "screw->organic_seal"
    ],
    "failure": "Unlimited native beacon retries: on a native death, replenish the independently recovered Sonic life counter to3 before native restart decrements it; retain cached abilities/gates in persistent task, reset scene enemies, refill energy/ammo on spawn."
  },
