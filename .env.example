# Server-only credentials. Never put this key in src/, game configs or browser storage.
OPENAI_API_KEY=
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_REALTIME_MODEL=gpt-live-transcribe
# Audio streams while recording; raw audio is not saved by Gameverse.
VOICE_MAX_SECONDS=120
VOICE_MAX_BYTES=10485760
VOICE_TIMEOUT_MS=30000
VOICE_MAX_STREAMS=2
# Standard browser gamepad index: 11 = R3. B / Circle (1) cancels.
VOICE_RECORD_BUTTON=11

# Gameverse v2: the decision model that routes ideas to a genre engine.
# auto (default) uses d1 on the local LiteLLM proxy when it answers, else OpenAI Decisions; or d1, openai, off.
V2_DECISIONS=auto
# LITELLM_BASE=http://rrh-llm-1:4000
# OPENAI_DECISIONS_BASE_URL=https://api.openai.com
