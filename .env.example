# Inject these into the calling process; tools do not automatically load dotenv.
# Keep actual values only in a secret store or ignored .env.local.
LITELLM_BASE=http://rrh-llm-1:4000
LITELLM_API_KEY=
OPENAI_API_KEY=

# Optional System 2. Explicit configuration; no automatic provider fallback.
PLAYTEST_LLM_BASE_URL=http://rrh-llm-1:4000
PLAYTEST_LLM_MODEL=ramblerun/Multimodal-AI
PLAYTEST_LLM_API_KEY=
PLAYTEST_LLM_ENABLE_THINKING=false
PLAYTEST_LLM_JSON_MODE=json_object

# Optional generation, separate from the Decisions model.
LITELLM_GENERATION_MODEL=ramblerun/Multimodal-AI
LITELLM_GENERATION_ENABLE_THINKING=false
# Required only for --generator openai; choose a supported generation model.
OPENAI_GENERATION_MODEL=
