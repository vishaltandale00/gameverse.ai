# Inject these into the calling process; tools do not automatically load dotenv.
# Keep actual values only in a secret store or ignored .env.local.
LITELLM_BASE=http://rrh-llm-1:4000
LITELLM_API_KEY=
OPENAI_API_KEY=
OPENAI_DECISIONS_BASE_URL=https://api.openai.com

# Optional System 2. Explicit configuration; no automatic provider fallback.
PLAYTEST_LLM_BASE_URL=http://rrh-llm-1:4000
PLAYTEST_LLM_MODEL=ramblerun/Multimodal-AI
PLAYTEST_LLM_API_KEY=
PLAYTEST_LLM_ENABLE_THINKING=false
PLAYTEST_LLM_JSON_MODE=json_object

# Optional generation, separate from the Decisions model.
LITELLM_GENERATION_MODEL=ramblerun/Multimodal-AI
LITELLM_GENERATION_ENABLE_THINKING=false
# Required only for --generator openai; choose a supported generation model.
OPENAI_GENERATION_MODEL=

# Local executable IR builds do not use model credentials.
# Existing packages/toolchain and actual native QA are required for Play.
IR_BUILD_TIMEOUT_MS=60000

# Server-only voice credentials. Never put keys in src/, game configs or browser storage.
# Uses OPENAI_API_KEY on the server; Python tools still require exported env.
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_REALTIME_MODEL=gpt-live-transcribe
# Audio streams while recording; raw audio is not saved by Gameverse.
VOICE_MAX_SECONDS=120
VOICE_MAX_BYTES=10485760
VOICE_TIMEOUT_MS=30000
VOICE_MAX_STREAMS=2
# Standard browser gamepad index: 11 = R3. B / Circle (1) cancels.
VOICE_RECORD_BUTTON=11
