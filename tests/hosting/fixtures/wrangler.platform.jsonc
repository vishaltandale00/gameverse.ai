{
  "name": "gameverse-platform-fixture",
  "main": "../../../infra/cloudflare/worker.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "send_metrics": false,
  "durable_objects": { "bindings": [
    { "name": "PROJECTS", "class_name": "ProjectState" },
    { "name": "AGENT_CONNECTIONS", "class_name": "AgentConnections" },
    { "name": "IDENTITY", "class_name": "IdentityState" },
    { "name": "ACCOUNT_JOBS", "class_name": "AccountJobs" },
    { "name": "SANDBOX_ADMISSION", "class_name": "SandboxAdmission" }
  ] },
  "migrations": [{ "tag": "fixture-v1", "new_sqlite_classes": ["ProjectState", "AgentConnections", "IdentityState", "AccountJobs", "SandboxAdmission"] }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "gameverse-platform-fixture", "remote": false }]
}
