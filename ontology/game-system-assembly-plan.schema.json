{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gameverse.game-system-assembly-plan/1",
  "title": "Player-facing game system assembly plan",
  "description": "Design requirements grounded in source modules. This schema does not certify runtime behavior or compatibility.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "label",
    "playerOutcome",
    "roles",
    "sharedState",
    "dependencies",
    "lifecycle",
    "lifecycleScope",
    "completionRequirements",
    "runtimeQualified"
  ],
  "properties": {
    "schema": {
      "const": "gameverse.game-system-assembly-plan/1"
    },
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "playerOutcome": {
      "type": "string"
    },
    "runtimeQualified": {
      "const": false
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "description",
          "capability",
          "required",
          "candidates"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "candidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/candidate"
            }
          }
        }
      }
    },
    "sharedState": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "fields",
          "rule"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "contract"
        ]
      }
    },
    "lifecycle": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifecycleScope": {
      "type": "string"
    },
    "completionRequirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "id",
        "label",
        "availability",
        "packageIds",
        "scope",
        "gaps",
        "evidence",
        "runtimeQualified"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "sourceSystemId": {
          "type": "string"
        },
        "availability": {
          "enum": [
            "published-subset",
            "source-only",
            "missing"
          ]
        },
        "packageIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string"
        },
        "gaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtimeQualified": {
          "const": false
        },
        "moduleId": {
          "type": "string",
          "description": "Canonical same-instance implementation identity across role views; never an instruction to copy actor/world state."
        },
        "roleFacets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "roleId",
              "capability",
              "status",
              "scope",
              "evidence"
            ],
            "properties": {
              "roleId": {
                "type": "string"
              },
              "capability": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "source-only",
                  "published-subset",
                  "missing"
                ]
              },
              "scope": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "canonicalState": {
          "type": "object",
          "required": [
            "identity",
            "fields",
            "aliasRule"
          ]
        },
        "sourceContractRef": {
          "type": "string",
          "description": "Exact existing source/native-host recovery contract when no normalized recovered-system ID exists."
        },
        "recordKind": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "packageIds": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "required": [
              "sourceGame"
            ],
            "properties": {
              "evidence": {
                "minItems": 1
              }
            },
            "anyOf": [
              {
                "required": [
                  "sourceSystemId"
                ]
              },
              {
                "required": [
                  "sourceContractRef"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
