{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gameverse.game-prefab-delivery/1",
  "type": "object",
  "required": [
    "schema",
    "gameId",
    "blueprintIds",
    "coreLoop",
    "bundles",
    "prefabs",
    "timing"
  ],
  "properties": {
    "schema": {
      "const": "gameverse.game-prefab-delivery/1"
    },
    "gameId": {
      "type": "string"
    },
    "blueprintIds": {
      "type": "array",
      "items": {
        "enum": [
          "character-traversal",
          "exploration-progression",
          "combat-encounter",
          "melee-action",
          "turn-based-party-battle",
          "racing-session",
          "dialogue-interactive-scenes",
          "hazard-recovery",
          "actors-world-lifecycle"
        ]
      }
    },
    "coreLoop": {
      "type": "object",
      "required": [
        "playerOutcome",
        "phases",
        "edges",
        "missingForCoreGame",
        "wholeGameReady"
      ],
      "properties": {
        "wholeGameReady": {
          "const": false
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "status",
              "prefabIds",
              "sourceRefs",
              "requiredServices",
              "gaps"
            ],
            "properties": {
              "status": {
                "enum": [
                  "usable-prefab",
                  "source-only",
                  "missing",
                  "internal-consumed"
                ]
              }
            }
          }
        }
      }
    },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "moduleId",
          "sourceGame",
          "planIds",
          "availability",
          "scope",
          "gaps",
          "evidence",
          "canonicalState",
          "roleFacets"
        ]
      }
    },
    "prefabs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "moduleId",
          "label",
          "path",
          "sha256",
          "validation",
          "validationSha256",
          "inputs",
          "outputs",
          "phases",
          "requiredServices",
          "gaps",
          "sourceRefs",
          "qualificationScope"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "validationSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "outputs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "required": [
        "runId",
        "sourceCommit",
        "environment",
        "totalSeconds",
        "accounting"
      ]
    }
  }
}
