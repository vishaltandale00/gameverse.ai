{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gameverse.recovered-systems-index/1",
  "type": "object",
  "required": [
    "schema",
    "systems",
    "games",
    "counts"
  ],
  "properties": {
