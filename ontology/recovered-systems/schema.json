      "const": "gameverse.recovered-systems-index/1"
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "gameId",
          "name",
          "readiness",
          "executable",
          "complete",
          "provenance",
          "coverage",
          "sourceFacts",
          "inputs",
          "outputs",
          "state",
          "events",
          "callOrder",
          "units",
          "aliases",
          "dependencies",
          "serviceEffects",
          "preconditions",
          "recordKind",
          "graph"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "gameId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "readiness": {
            "enum": [
              "static",
              "source-backed-system"
            ]
          },
          "executable": {
            "const": false
          },
          "complete": {
            "const": false
          },
          "provenance": {
            "type": "array",
            "minItems": 1
          },
          "coverage": {
            "type": "object"
          },
          "sourceFacts": {
            "type": "object"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "provenance"
              ],
              "properties": {
                "provenance": {
                  "type": "object",
                  "required": [
                    "ref",
                    "pointer"
                  ]
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "provenance"
              ],
              "properties": {
                "provenance": {
                  "type": "object",
                  "required": [
                    "ref",
                    "pointer"
                  ]
                }
              }
            }
          },
          "state": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "provenance"
              ],
              "properties": {
                "provenance": {
                  "type": "object",
                  "required": [
                    "ref",
                    "pointer"
                  ]
                }
              }
            }
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "provenance"
              ],
              "properties": {
                "provenance": {
                  "type": "object",
                  "required": [
                    "ref",
                    "pointer"
                  ]
                }
              }
            }
          },
          "callOrder": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "provenance"
              ],
              "properties": {
                "provenance": {
                  "type": "object",
                  "required": [
                    "ref",
                    "pointer"
                  ]
                }
              }
            }
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "provenance"
              ],
              "properties": {
                "provenance": {
                  "type": "object",
                  "required": [
                    "ref",
                    "pointer"
                  ]
                }
              }
            }
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "provenance"
              ],
              "properties": {
                "provenance": {
                  "type": "object",
                  "required": [
                    "ref",
                    "pointer"
                  ]
                }
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "provenance"
              ],
              "properties": {
                "provenance": {
                  "type": "object",
                  "required": [
                    "ref",
                    "pointer"
                  ]
                }
              }
            }
          },
          "serviceEffects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "value",
                "provenance"
              ],
              "properties": {
                "provenance": {
                  "type": "object",
                  "required": [
                    "ref",
                    "pointer"
                  ]
                }
              }
            }
          },
          "preconditions": {
            "type": "array",
