              "source-system-contract"
            ]
          },
          "graph": {
            "type": "object",
            "required": [
              "nodes",
              "edges",
              "scope"
            ],
            "properties": {
              "nodes": {
                "type": "array"
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "from",
                    "to",
                    "support",
                    "executable",
                    "claim",
                    "provenance"
                  ],
                  "properties": {
                    "support": {
                      "enum": [
                        "unresolved",
                        "source-assertion-unqualified"
                      ]
                    },
                    "executable": {
                      "const": false
                    }
                  }
                }
              },
              "scope": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "games": {
      "type": "array"
    },
    "counts": {
      "type": "object"
