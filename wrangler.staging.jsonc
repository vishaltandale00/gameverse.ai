{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameverse-host-staging",
  "main": "infra/cloudflare/worker.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "routes": [{ "pattern": "gameverse.build", "custom_domain": true }],
  "preview_urls": false,
  "send_metrics": false,
  "limits": { "cpu_ms": 100 },
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "APP_ENV": "staging",
    "HOST_RECONCILE_MS": "5000",
    "MAX_OBJECT_BYTES": "1048576"
  },
  "secrets": { "required": ["STAGING_API_TOKEN", "DAYTONA_API_KEY", "ACCOUNT_ID_KEY", "AGENT_CREDENTIAL_KEY", "TWILIO_ACCOUNT_SID", "TWILIO_AUTH_TOKEN", "TWILIO_VERIFY_SERVICE_SID", "GAMEVERSE_PILOT_PHONES", "GAMEVERSE_DEVELOPER_PHONES"] },
  "durable_objects": {
    "bindings": [
      { "name": "PROJECTS", "class_name": "ProjectState" },
      { "name": "AGENT_CONNECTIONS", "class_name": "AgentConnections" },
      { "name": "IDENTITY", "class_name": "IdentityState" },
      { "name": "ACCOUNT_JOBS", "class_name": "AccountJobs" },
      { "name": "SANDBOX_ADMISSION", "class_name": "SandboxAdmission" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectState"] },
    { "tag": "v2", "new_sqlite_classes": ["AgentConnections"] },
    { "tag": "v3", "new_sqlite_classes": ["IdentityState", "AccountJobs", "SandboxAdmission"] }
  ],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "gameverse-artifacts-staging", "remote": false }
  ]
}
